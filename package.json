{
  "name": "zuri-travel-crm",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "db:migrate": "node scripts/database.ts migrate",
    "db:seed": "node scripts/database.ts seed",
    "db:setup": "node scripts/database.ts seed",
    "db:reset": "node scripts/database.ts reset",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy",
    "db:seed:cloudflare": "node scripts/cloudflare-seed.ts",
    "test:e2e:worker": "CRM_E2E_TARGET=workers playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@vinext/cloudflare": "^1.4.0",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-server-dom-webpack": "^19.3.1",
    "recharts": "^3.5.0",
    "vinext": "^1.4.6",
    "zod": "^4.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^2.0.0-rc.2",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitejs/plugin-rsc": "^0.5.39",
    "cf": "^1.0.0-rc.2",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "fflate": "0.7.5"
  },
  "allowScripts": {
    "workerd@1.20261117.1": true,
    "workerd@1.20261118.1": true
  }
}
